{
  "name": "sri-annur-readymades-pos",
  "productName": "Sri Annur Readymades POS",
  "version": "1.0.0",
  "description": "Sri Annur Readymades POS Desktop Application",
  "author": "Shyam",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sriannur.pos",
    "productName": "Sri Annur Readymades POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/BoutiqueFlowBackend.exe",
        "to": "backend/BoutiqueFlowBackend.exe"
      },
      {
        "from": "../backend/.env",
        "to": "backend/.env"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sri Annur Readymades POS"
    }
  }
}